---
import '../styles/global.css';

const title = '页面不存在 | 李潇然';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <main class="not-found">
      <p class="not-found__code">404 · NOT FOUND</p>
      <h1>这页暂时不存在。</h1>
      <p>你可以回到首页，继续查看项目、笔记和判断。</p>
      <a href="/">回到首页</a>
    </main>
  </body>
</html>

<style>
  .not-found {
    display: grid;
    min-height: 100vh;
    place-content: center;
    gap: 16px;
    padding: 32px;
  }

  .not-found h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 8vw, 5rem);
  }

  .not-found__code {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
  }

  .not-found a {
    width: fit-content;
    margin-top: 12px;
  }
</style>
